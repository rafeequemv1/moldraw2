{
  "manifest_version": 3,
  "name": "MolDraw Chrome plugin",
  "short_name": "MolDraw",
  "version": "1.0.0",
  "description": "Capture a molecule from any page, convert it with Mathpix, and open it editable in MolDraw.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "MolDraw",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.mathpix.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture-molecule": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Capture a molecule screenshot"
    }
  }
}
