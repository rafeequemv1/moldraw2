{
  "name": "@moldraw/domain",
  "version": "0.1.0",
  "description": "Atom/Bond/Molecule types and chemistry rules for Moldraw (no React)",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
