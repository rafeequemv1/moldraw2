{
  "name": "@moldraw/engine",
  "version": "0.1.0",
  "description": "Native 2D layout/cleanup and molecule I/O engine for Moldraw",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@moldraw/core": "workspace:^",
    "@moldraw/domain": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
