{
  "name": "@moldraw/plugin-host",
  "version": "1.0.0",
  "description": "Internal Moldraw plugin host — lifecycle, install store, registry merge",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@moldraw/plugin-sdk": "workspace:^",
    "@moldraw/plugin-proteins": "workspace:^",
    "@moldraw/plugin-spectroscopy": "workspace:^",
    "@moldraw/plugin-themes": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
