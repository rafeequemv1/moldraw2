{
  "name": "@moldraw/plugin-proteins",
  "version": "1.0.0",
  "description": "Protein structure viewer with PDB import, sequence selection, and styling",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": ["./src/proteins.css"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./proteins.css": "./src/proteins.css"
  },
  "moldrawPlugin": {
    "id": "proteins",
    "name": "Proteins",
    "version": "1.0.0",
    "description": "Load and view proteins from PDB with sequence selection and style controls",
    "capabilities": ["panel", "filesystem"],
    "engine": "^1.0.0",
    "defaultInstalled": true
  },
  "dependencies": {
    "@moldraw/plugin-sdk": "workspace:^",
    "@moldraw/viewer-3d": "workspace:^",
    "3dmol": "^2.5.4",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
