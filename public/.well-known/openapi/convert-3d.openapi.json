{
  "openapi": "3.1.0",
  "info": {
    "title": "MolDraw 3D Conversion API",
    "version": "1.0.0",
    "description": "Generate a 3D SDF conformer from SMILES using NCI Cactus."
  },
  "servers": [
    { "url": "https://www.moldraw.com" }
  ],
  "paths": {
    "/api/convert-3d": {
      "post": {
        "summary": "Convert SMILES to 3D SDF",
        "operationId": "convert3d",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "smiles": { "type": "string", "example": "CCO" },
                  "molfile": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "3D conversion result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sdf": { "type": ["string", "null"] },
                    "source": { "type": "string", "example": "nci-cactus" },
                    "stats": { "type": "object" },
                    "tier": { "type": "string" },
                    "tried": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
