{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@moldraw/domain": ["./packages/domain/src"],
      "@moldraw/domain/*": ["./packages/domain/src/*"],
      "@moldraw/engine": ["./packages/engine/src"],
      "@moldraw/engine/*": ["./packages/engine/src/*"],
      "@moldraw/core": ["./packages/core/src"],
      "@moldraw/core/*": ["./packages/core/src/*"],
      "@moldraw/canvas": ["./packages/canvas/src"],
      "@moldraw/canvas/*": ["./packages/canvas/src/*"],
      "@moldraw/engine-2d": ["./packages/engine-2d/src"],
      "@moldraw/engine-2d/*": ["./packages/engine-2d/src/*"],
      "@moldraw/engine-3d": ["./packages/engine-3d/src"],
      "@moldraw/engine-3d/*": ["./packages/engine-3d/src/*"],
      "@moldraw/viewer-3d": ["./packages/viewer-3d/src"],
      "@moldraw/viewer-3d/*": ["./packages/viewer-3d/src/*"],
      "@moldraw/ai": ["./packages/ai/src"],
      "@moldraw/ai/*": ["./packages/ai/src/*"],
      "@moldraw/templates": ["./packages/templates/src"],
      "@moldraw/templates/*": ["./packages/templates/src/*"],
      "@moldraw/reactions": ["./packages/reactions/src"],
      "@moldraw/reactions/*": ["./packages/reactions/src/*"],
      "@moldraw/plugin-sdk": ["./packages/plugin-sdk/src"],
      "@moldraw/plugin-sdk/*": ["./packages/plugin-sdk/src/*"],
      "@moldraw/plugin-host": ["./packages/plugin-host/src"],
      "@moldraw/plugin-host/*": ["./packages/plugin-host/src/*"],
      "@moldraw/plugin-spectroscopy": ["./plugins/spectroscopy/src"],
      "@moldraw/plugin-spectroscopy/*": ["./plugins/spectroscopy/src/*"],
      "@moldraw/plugin-proteins": ["./plugins/proteins/src"],
      "@moldraw/plugin-proteins/*": ["./plugins/proteins/src/*"],
      "@moldraw/plugin-smart-draw": ["./plugins/smart-draw/src"],
      "@moldraw/plugin-smart-draw/*": ["./plugins/smart-draw/src/*"],
      "@moldraw/plugin-themes": ["./plugins/themes/src"],
      "@moldraw/plugin-themes/*": ["./plugins/themes/src/*"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "packages/*/src", "plugins/*/src"],
  "exclude": [
    "src/domain/**",
    "src/core/**",
    "src/engine/**",
    "src/engine-2d/**",
    "src/engine-3d/**",
    "src/viewer-3d/**",
    "src/features/canvas/**",
    "src/features/viewer3d/**",
    "src/ai/schemas/**",
    "packages/engine/src/__tests__/**",
    "packages/engine/src/indigo/**",
    "packages/core/src/__tests__/**",
    "packages/ai/src/__tests__/**",
    "packages/ai/src/mcp/**",
    "packages/ai/src/http/**",
    "packages/ai/src/session/persistFile.ts",
    "packages/ai/src/session/loadMoleculeFile.ts",
    "packages/ai/src/session/createHeadlessSession.ts",
    "plugins/smart-draw/src/__tests__/**"
  ]
}
