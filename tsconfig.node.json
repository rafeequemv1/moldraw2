{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@moldraw/domain": ["./packages/domain/src"],
      "@moldraw/domain/*": ["./packages/domain/src/*"],
      "@moldraw/engine": ["./packages/engine/src"],
      "@moldraw/engine/*": ["./packages/engine/src/*"],
      "@moldraw/core": ["./packages/core/src"],
      "@moldraw/core/*": ["./packages/core/src/*"],
      "@moldraw/canvas": ["./packages/canvas/src"],
      "@moldraw/canvas/*": ["./packages/canvas/src/*"],
      "@moldraw/engine-2d": ["./packages/engine-2d/src"],
      "@moldraw/engine-2d/*": ["./packages/engine-2d/src/*"],
      "@moldraw/engine-3d": ["./packages/engine-3d/src"],
      "@moldraw/engine-3d/*": ["./packages/engine-3d/src/*"],
      "@moldraw/viewer-3d": ["./packages/viewer-3d/src"],
      "@moldraw/viewer-3d/*": ["./packages/viewer-3d/src/*"],
      "@moldraw/ai": ["./packages/ai/src"],
      "@moldraw/ai/*": ["./packages/ai/src/*"],
      "@moldraw/templates": ["./packages/templates/src"],
      "@moldraw/templates/*": ["./packages/templates/src/*"],
      "@moldraw/plugin-sdk": ["./packages/plugin-sdk/src"],
      "@moldraw/plugin-sdk/*": ["./packages/plugin-sdk/src/*"],
      "@moldraw/plugin-host": ["./packages/plugin-host/src"],
      "@moldraw/plugin-host/*": ["./packages/plugin-host/src/*"],
      "@moldraw/plugin-spectroscopy": ["./plugins/spectroscopy/src"],
      "@moldraw/plugin-spectroscopy/*": ["./plugins/spectroscopy/src/*"],
      "@moldraw/plugin-proteins": ["./plugins/proteins/src"],
      "@moldraw/plugin-proteins/*": ["./plugins/proteins/src/*"],
      "@moldraw/plugin-themes": ["./plugins/themes/src"],
      "@moldraw/plugin-themes/*": ["./plugins/themes/src/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "scripts/generate-plugin-artifacts.ts",
    "scripts/generate-docs-seo.ts",
    "src/features/documentation/docNav.ts",
    "packages/ai/src/**/*.ts"
  ]
}
