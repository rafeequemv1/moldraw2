{
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/convert-3d.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/mcp.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/community.js": {
      "maxDuration": 10,
      "includeFiles": "public/community/index.html"
    },
    "api/community-sitemap.js": {
      "maxDuration": 10
    },
    "api/community-notify.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"llms-txt\"; type=\"text/plain\", </.well-known/mcp.json>; rel=\"mcp-server-card\"; type=\"application/json\", </.well-known/agent-skills/index.json>; rel=\"agent-skills\"; type=\"application/json\", </.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\""
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\""
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/mcp.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/agent-skills/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/md/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/((?!embed).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/embed/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "moldraw.com" }],
      "destination": "https://www.moldraw.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tools/index.html",
      "destination": "/tools/",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/tools/free-chem-tools/index.html",
      "destination": "/tools/free-chem-tools/",
      "permanent": true
    },
    {
      "source": "/documentation/index.html",
      "destination": "/documentation/",
      "permanent": true
    },
    {
      "source": "/community/index.html",
      "destination": "/community/",
      "permanent": true
    },
    {
      "source": "/reaction/index.html",
      "destination": "/reaction/",
      "permanent": true
    },
    {
      "source": "/course/",
      "destination": "/course/index.html",
      "permanent": true
    },
    {
      "source": "/course",
      "destination": "/course/index.html",
      "permanent": true
    },
    {
      "source": "/reaction/aldol-condensation/",
      "destination": "/reaction/aldol-condensation",
      "permanent": true
    },
    {
      "source": "/reaction/wittig-reaction/",
      "destination": "/reaction/wittig-reaction",
      "permanent": true
    },
    {
      "source": "/reaction/grignard-reaction/",
      "destination": "/reaction/grignard-reaction",
      "permanent": true
    },
    {
      "source": "/reaction/suzuki-coupling/",
      "destination": "/reaction/suzuki-coupling",
      "permanent": true
    },
    {
      "source": "/reaction/heck-reaction/",
      "destination": "/reaction/heck-reaction",
      "permanent": true
    },
    {
      "source": "/reaction/friedel-crafts-acylation/",
      "destination": "/reaction/friedel-crafts-acylation",
      "permanent": true
    },
    {
      "source": "/reaction/diels-alder-reaction/",
      "destination": "/reaction/diels-alder-reaction",
      "permanent": true
    },
    {
      "source": "/addons/index.html",
      "destination": "/addons/",
      "permanent": true
    },
    {
      "source": "/chrome-addon/index.html",
      "destination": "/chrome-addon",
      "permanent": true
    },
    {
      "source": "/chrome-addon/",
      "destination": "/chrome-addon",
      "permanent": true
    },
    {
      "source": "/chromeaddon",
      "destination": "/chrome-addon",
      "permanent": true
    },
    {
      "source": "/chromeaddon/",
      "destination": "/chrome-addon",
      "permanent": true
    },
    {
      "source": "/chrome-extension",
      "destination": "/chrome-addon",
      "permanent": true
    },
    {
      "source": "/chrome-plugin",
      "destination": "/chrome-addon",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/embed",
      "destination": "/index.html"
    },
    {
      "source": "/embed/",
      "destination": "/index.html"
    },
    {
      "source": "/community/sitemap.xml",
      "destination": "/api/community-sitemap"
    },
    {
      "source": "/community",
      "destination": "/api/community?path=/community"
    },
    {
      "source": "/community/",
      "destination": "/api/community?path=/community/"
    },
    {
      "source": "/community/page/:page",
      "destination": "/api/community?path=/community/page/:page"
    },
    {
      "source": "/community/features",
      "destination": "/api/community?path=/community/features"
    },
    {
      "source": "/community/features/page/:page",
      "destination": "/api/community?path=/community/features/page/:page"
    },
    {
      "source": "/community/p/:id",
      "destination": "/api/community?path=/community/p/:id"
    },
    {
      "source": "/community/p/:id/:slug",
      "destination": "/api/community?path=/community/p/:id/:slug"
    },
    {
      "source": "/community/c/:id",
      "destination": "/api/community?path=/community/c/:id"
    },
    {
      "source": "/community/c/:id/:slug",
      "destination": "/api/community?path=/community/c/:id/:slug"
    },
    {
      "source": "/community/f/:id",
      "destination": "/api/community?path=/community/f/:id"
    },
    {
      "source": "/community/f/:id/:slug",
      "destination": "/api/community?path=/community/f/:id/:slug"
    },
    {
      "source": "/community/fc/:id",
      "destination": "/api/community?path=/community/fc/:id"
    },
    {
      "source": "/community/fc/:id/:slug",
      "destination": "/api/community?path=/community/fc/:id/:slug"
    },
    {
      "source": "/community/u/:id",
      "destination": "/api/community?path=/community/u/:id"
    },
    {
      "source": "/community/u/:id/:slug",
      "destination": "/api/community?path=/community/u/:id/:slug"
    }
  ]
}
